# URL base del API Gateway. '/api' usa el proxy de Vite en desarrollo (ver VITE_GATEWAY_URL).
VITE_API_BASE_URL=/api
# Destino del proxy de desarrollo (gateway, puerto 8080 por defecto).
VITE_GATEWAY_URL=http://localhost:8080

# Rutas por dominio, relativas a VITE_API_BASE_URL (coinciden con las rutas del gateway).
VITE_EP_AUTH=/auth
VITE_EP_CLIENTES=/clientes
VITE_EP_COTIZACIONES=/cotizaciones
VITE_EP_POLIZAS=/polizas
VITE_EP_SINIESTROS=/siniestros

# Dominios que usan datos simulados (sin backend), separados por coma:
# auth, clientes, cotizaciones, polizas, siniestros  |  'all' = todo simulado (demo sin backend)
# Cuando Pólizas y Siniestros estén migrados, quítalos de esta lista.
VITE_MOCK_DOMAINS=polizas

# Latencia artificial de los datos simulados (ms).
VITE_MOCK_LATENCY_MS=350
